{
  "name": "keren-analytics",
  "version": "0.1.0",
  "description": "Azure GA-like analytics dashboard (plug-and-play)",
  "type": "module",
  "main": "src/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --env-file=.env.test --test tests/*.test.js",
    "test:coverage": "node --disable-warning=ExperimentalWarning --env-file=.env.test --experimental-test-coverage --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:security": "node scripts/security-audit.mjs",
    "docs:bundle": "bash scripts/build-strategy-bundle.sh",
    "build:contract": "node --disable-warning=ExperimentalWarning scripts/build-telemetry-contract.mjs",
    "backup:sqlite": "node --disable-warning=ExperimentalWarning scripts/backup-sqlite.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lionelgarnier/keren-analytics.git"
  },
  "keywords": [],
  "author": "Lionel Garnier <garniel6@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lionelgarnier/keren-analytics/issues"
  },
  "homepage": "https://github.com/lionelgarnier/keren-analytics#readme",
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "^12.28.0",
    "applicationinsights": "^3.9.0",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "protobufjs": "^7.6.2",
    "qs": "^6.15.2",
    "uuid": "^11.1.1",
    "form-data": "^4.0.6",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/propagator-jaeger": "^2.9.0"
  }
}
