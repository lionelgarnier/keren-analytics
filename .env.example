# Keren Analytics - Environment Configuration
#
# Copy this file to .env and fill in your values.
# See docs/setup-entra-id.md for detailed instructions.

# Mode: "mock" (sample data, no Azure needed) or "real" (requires Azure credentials)
AZURE_MODE=mock

# Session secret. REQUIRED in production — startup fails if NODE_ENV=production
# and this is missing or set to a known placeholder.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production

# Optional server port (defaults to 3000)
# PORT=3000

# --- Azure OAuth (required for AZURE_MODE=real) ---
# Register an app in Entra ID (Azure AD) and fill in these values:
# AZURE_CLIENT_ID=your-app-client-id
# AZURE_CLIENT_SECRET=your-app-client-secret
# AZURE_REDIRECT_URI=http://localhost:3000/auth/callback
# AZURE_TENANT_ID=organizations

# --- Mock mode options ---
# Set to "multiple" to simulate multiple App Insights resources
# MOCK_RESOURCES=multiple

# --- AI provider ---
# AI_PROVIDER=none
# AZURE_FOUNDRY_ENDPOINT=https://<project>.services.ai.azure.com/api/projects/<project>/openai/v1/responses
# AZURE_FOUNDRY_DEPLOYMENT=gpt-5.4-mini
# Optional: user-assigned MI client id in Azure
# AZURE_FOUNDRY_CLIENT_ID=<managed-identity-client-id>

# --- SQLite backup scheduler (Azure Blob) ---
# BACKUP_BLOB_ACCOUNT=<storage-account-name>
# BACKUP_BLOB_CONTAINER=sqlite-backups
# BACKUP_INTERVAL_MS=3600000
# BACKUP_MAX_SNAPSHOTS=24
