let start={{timeStart}};
let end={{timeEnd}};
{{tableName}}
| where timestamp between (start..end)
| extend dowRaw = toint(dayofweek(timestamp) / 1d)
| extend dayIndex = iif(dowRaw == 0, 6, dowRaw - 1)
| extend hour = hourofday(timestamp)
| extend canonicalSessionId = {{sessionIdExpr}}
| summarize count = dcountif(canonicalSessionId, isnotempty(canonicalSessionId))
  by dayIndex, hour
| order by dayIndex asc, hour asc
