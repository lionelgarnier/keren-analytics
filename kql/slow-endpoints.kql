let start={{timeStart}};
let end={{timeEnd}};
requests
| where timestamp between (start..end)
| extend urlPath = tostring(parse_url(url).Path)
| extend namePath = extract("(?:GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS|RSC GET|RSC POST)\\s+([^?\\s]+)", 1, name)
| extend path = iif(isnotempty(urlPath), urlPath, namePath)
| where isnotempty(path)
| extend statusCode = toint(resultCode)
| summarize
    p50 = percentile(duration, 50),
    p95 = percentile(duration, 95),
    p99 = percentile(duration, 99),
    avgDuration = avg(duration),
    count = count(),
    errors = countif(success == false and (isnull(statusCode) or statusCode >= 500))
  by path
| extend errorRate = iif(count == 0, 0.0, todouble(errors) / todouble(count))
| project path, p50, p95, p99, avgDuration, count, errorRate
| top 10 by p95 desc
