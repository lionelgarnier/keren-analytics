let start={{timeStart}};
let end={{timeEnd}};
requests
| where timestamp between (start..end)
| extend path = tostring(parse_url(url).Path)
| where isnotempty(path)
| summarize
    p50 = percentile(duration, 50),
    p95 = percentile(duration, 95),
    p99 = percentile(duration, 99),
    avgDuration = avg(duration),
    count = count(),
    errors = countif(success == false)
  by path
| extend errorRate = iif(count == 0, 0.0, todouble(errors) / todouble(count))
| project path, p50, p95, p99, avgDuration, count, errorRate
| top 10 by p95 desc
