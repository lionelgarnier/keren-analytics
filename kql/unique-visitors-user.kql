// Distinct visitors using authenticated user IDs with session fallback
let start={{timeStart}};
let end={{timeEnd}};
{{tableName}}
| where timestamp between (start..end)
| extend canonicalUserId = {{userIdExpr}}
| extend canonicalSessionId = {{sessionIdExpr}}
| extend canonicalIdentity = iif(isnotempty(canonicalUserId), canonicalUserId, canonicalSessionId)
| summarize uniqueVisitors = dcountif(canonicalIdentity, isnotempty(canonicalIdentity))
