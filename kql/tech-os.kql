let start={{timeStart}};
let end={{timeEnd}};
let total = toscalar(
  {{tableName}}
  | where timestamp between (start..end)
  | where isnotempty(client_OS)
  | summarize count()
);
{{tableName}}
| where timestamp between (start..end)
| where isnotempty(client_OS)
| summarize count = count() by os = client_OS
| top 5 by count desc
| extend total = total
