// Top operating systems by event count for the Technical breakdown
let start={{timeStart}};
let end={{timeEnd}};
let total = toscalar(
  {{tableName}}
  | where timestamp between (start..end)
  | where isnotempty({{osExpr}})
  | summarize count()
);
{{tableName}}
| where timestamp between (start..end)
| where isnotempty({{osExpr}})
| summarize count = count() by os = {{osExpr}}
| top 5 by count desc
| extend total = total
