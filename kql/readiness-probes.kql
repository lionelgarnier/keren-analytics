// Readiness signal counts and latest telemetry timestamp for the Readiness view
let start={{timeStart}};
let end={{timeEnd}};
let events = union isfuzzy=true withsource=tableName pageViews, requests
| where timestamp between (start..end);
let pageViewsCount = toscalar(events | where tableName == "pageViews" | count);
let requestsCount = toscalar(events | where tableName == "requests" | count);
let userAuthCount = toscalar(events | where isnotempty(user_AuthenticatedId) | summarize dcount(user_AuthenticatedId));
let userAnonCount = toscalar(events | where isnotempty(user_Id) | summarize dcount(user_Id));
let sessionCount = toscalar(events | where isnotempty(session_Id) | summarize dcount(session_Id));
let requestSessionCount = toscalar(events | where tableName == "requests" and isnotempty(session_Id) | summarize dcount(session_Id));
let browserCount = toscalar(events | where isnotempty(client_Browser) | count);
let osCount = toscalar(events | where isnotempty(client_OS) | count);
let deviceCount = toscalar(events | where isnotempty(client_Type) | count);
let geoCount = toscalar(events | where isnotempty(client_CountryOrRegion) | count);
let latestTimestamp = toscalar(events | summarize max(timestamp));
let browserTimingsCount = toscalar(union isfuzzy=true browserTimings | where timestamp between (start..end) | count);
let urlPopulatedCount = toscalar(events | where isnotempty(url) | count);
let namePopulatedCount = toscalar(events | where isnotempty(name) | count);
let headerRefererCount = toscalar(events | where isnotempty(tostring(customDimensions["http.request.header.referer"])) | count);
let dependenciesCount = toscalar(union isfuzzy=true dependencies | where timestamp between (start..end) | count);
let exceptionsCount = toscalar(union isfuzzy=true exceptions | where timestamp between (start..end) | count);
let roleCount = toscalar(events | where isnotempty(cloud_RoleName) | summarize dcount(cloud_RoleName));
print pageViewsCount = pageViewsCount, requestsCount = requestsCount,
      userAuthCount = userAuthCount, userAnonCount = userAnonCount,
      sessionCount = sessionCount, requestSessionCount = requestSessionCount,
      browserCount = browserCount, osCount = osCount, deviceCount = deviceCount,
      geoCount = geoCount, browserTimingsCount = browserTimingsCount,
      latestTimestamp = latestTimestamp,
      urlPopulatedCount = urlPopulatedCount, namePopulatedCount = namePopulatedCount,
      headerRefererCount = headerRefererCount,
      dependenciesCount = dependenciesCount, exceptionsCount = exceptionsCount,
      roleCount = roleCount
