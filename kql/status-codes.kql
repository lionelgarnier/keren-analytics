// HTTP response-code class distribution (2xx/3xx/4xx/5xx) for the Backend view
let start={{timeStart}};
let end={{timeEnd}};
requests
| where timestamp between (start..end)
| extend statusCode = toint(resultCode)
| extend codeClass = case(
    isnull(statusCode), "other",
    statusCode >= 500, "5xx",
    statusCode >= 400, "4xx",
    statusCode >= 300, "3xx",
    statusCode >= 200, "2xx",
    "other")
| summarize count = count() by codeClass
| order by codeClass asc
