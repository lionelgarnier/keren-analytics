// Top device types by event count for the Technical breakdown
let start={{timeStart}};
let end={{timeEnd}};
let total = toscalar(
  {{tableName}}
  | where timestamp between (start..end)
  | where isnotempty({{deviceExpr}})
  | summarize count()
);
{{tableName}}
| where timestamp between (start..end)
| where isnotempty({{deviceExpr}})
| summarize count = count() by device = {{deviceExpr}}
| top 5 by count desc
| extend total = total
