let start={{timeStart}};
let end={{timeEnd}};
let total = toscalar(
  {{tableName}}
  | where timestamp between (start..end)
  | extend pagePath = {{pagePathExpr}}
  | where isnotempty(pagePath)
  | summarize count()
);
{{tableName}}
| where timestamp between (start..end)
| extend pagePath = {{pagePathExpr}}
| where isnotempty(pagePath)
| summarize views = count() by pagePath
| top 10 by views desc
| extend share = iif(total == 0, 0.0, views * 1.0 / total)
