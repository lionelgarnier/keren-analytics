// Time-bucketed visitors and page views for dashboard trend charts
let start={{timeStart}};
let end={{timeEnd}};
{{tableName}}
| where timestamp between (start..end)
| extend pagePath = {{pagePathExpr}}
| extend canonicalSessionId = {{sessionIdExpr}}
| summarize
    visitors = dcountif(canonicalSessionId, isnotempty(canonicalSessionId)),
    pageViews = countif(isnotempty(pagePath))
  by period = bin(timestamp, {{binSize}})
| order by period asc
