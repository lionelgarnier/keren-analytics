// Auto-detect URL parameters from telemetry
// Scans URLs (or request names when url is empty), extracts query string parameters
let startTime = {{timeStart}};
let endTime = {{timeEnd}};
let allEvents = {{tableName}}
| where timestamp between (startTime .. endTime)
| extend rawUrl = iif(isnotempty(url), url, name);
let totalScanned = toscalar(allEvents | count);
let urlsWithParams = toscalar(allEvents | where rawUrl contains "?" | count);
allEvents
| where rawUrl contains "?"
| extend qs = substring(rawUrl, indexof(rawUrl, "?") + 1)
| extend qs = iif(qs contains " ", substring(qs, 0, indexof(qs, " ")), qs)
| extend qs = iif(qs contains "#", substring(qs, 0, indexof(qs, "#")), qs)
| where isnotempty(qs)
| mv-expand kvPair = split(qs, "&")
| extend paramName = tostring(split(tostring(kvPair), "=")[0])
| extend paramValue = tostring(split(tostring(kvPair), "=")[1])
| where isnotempty(paramName)
| summarize
    frequency = count(),
    distinctValues = dcount(paramValue),
    topValue = any(paramValue)
  by paramName
| extend isUtm = paramName startswith "utm_"
| extend totalScanned = totalScanned, urlsWithParams = urlsWithParams
| order by frequency desc
| take 20
