// Earliest and latest timestamps plus event counts per telemetry table for setup analysis
let start={{timeStart}};
let end={{timeEnd}};
union isfuzzy=true withsource=tableName pageViews, requests, customEvents, dependencies, exceptions, traces, browserTimings
| where timestamp between (start..end)
| summarize earliest = min(timestamp),
            latest = max(timestamp),
            eventCount = count()
          by tableName
