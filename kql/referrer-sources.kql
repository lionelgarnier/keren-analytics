// Referrer source breakdown
// Groups traffic by referrer origin: Direct, Organic Search, Referral, Social, Email
// Falls back to customDimensions headers for Sentry/OTEL SDKs
let startTime = {{timeStart}};
let endTime = {{timeEnd}};
{{tableName}}
| where timestamp between (startTime .. endTime)
| extend rawReferrer = coalesce(
    {{referrerExpr}},
    tostring(customDimensions["referrer"]),
    tostring(customDimensions["http.request.header.referer"]),
    "")
| extend referrerHost = tostring(parse_url(rawReferrer).Host)
| extend pageHost = coalesce(
    tostring(parse_url(url).Host),
    tostring(customDimensions["http.request.header.host"]),
    "")
| extend source = case(
    isempty(referrerHost) or referrerHost == "", "Direct",
    referrerHost == pageHost, "Direct",
    referrerHost has_any ("google", "bing", "yahoo", "duckduckgo", "baidu", "ecosia", "yandex"), "Organic Search",
    referrerHost has_any ("facebook", "twitter", "linkedin", "instagram", "reddit", "tiktok", "youtube", "t.co", "lnkd.in") or referrerHost contains "linkedin", "Social",
    referrerHost has_any ("mail", "outlook", "gmail", "protonmail"), "Email",
    "Referral"
  )
| summarize count=count() by source
| order by count desc
