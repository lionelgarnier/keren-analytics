// Top browsers by event count for the Technical breakdown
let start={{timeStart}};
let end={{timeEnd}};
let total = toscalar(
  {{tableName}}
  | where timestamp between (start..end)
  | where isnotempty({{browserExpr}})
  | summarize count()
);
{{tableName}}
| where timestamp between (start..end)
| where isnotempty({{browserExpr}})
| summarize count = count() by browser = {{browserExpr}}
| top 5 by count desc
| extend total = total
